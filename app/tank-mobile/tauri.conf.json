{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TANK的英雄笔记",
  "version": "1.1.14",
  "identifier": "com.flowix.app.mobile",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev:mobile -- --port 1421",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": {
      "script": "npm run build:mobile",
      "cwd": "../.."
    },
    "frontendDist": "../../.build/web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TANK的英雄笔记",
        "width": 430,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "disableInputAccessoryView": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost https://asset.localhost data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost http://asset.localhost https://asset.localhost https://cloud.flowix-memo.com; worker-src 'self' blob:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/notebooks/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../tank-desktop/icons/32x32.png",
      "../tank-desktop/icons/128x128.png",
      "../tank-desktop/icons/128x128@2x.png",
      "../tank-desktop/icons/icon.icns",
      "../tank-desktop/icons/icon.ico"
    ]
  }
}
